/vendor/*
/node_modules/

/build/*
/tools/*
/var/*

# Customized Configuration Files
/config/config.php
/config/log4php.config.xml
/config/custom-version.txt
/config/version-suffix.txt
**/*.config.php

/lib/external/phpqrcode/cache/*
!/lib/external/phpqrcode/cache/index.html

/plugins/*
!/plugins/Authentication
!/plugins/**/index.html
!/plugins/**/*Example/*

# Smarty Cache / compiled templates
/tpl_c/*
!/tpl_c/index.html

# Customization Files
/Web/custom-favicon.png
/Web/img/custom-logo.png
lang/*/*-custom.tpl

# Upload Directories
/uploads/*
!/uploads/index.html

/Web/uploads/images/*
!/Web/uploads/images/index.html
/Web/uploads/tos/*
!/Web/uploads/tos/index.html

/Web/test-embed.html

# /phpunit.xml.dist is tracked
/phpunit.xml

# /.php-cs-fixer.dist.php is tracked
.php-cs-fixer.php

/.phpdoc
# /phpdoc.dist.xml is tracked
/phpdoc.xml

# Editor Cache Files
.idea

.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

*.sublime-workspace

.DS_Store

# php8 phpcompatibility report
php8-report.log

# phpunit cache
.phpunit.cache/
.env

# ZHL: local-only test creds
docs/zhl/CREDENTIALS-LOCAL.md

# ZHL: track our custom permission plugin (rest of plugins/ stays ignored)
!/plugins/Permission
/plugins/Permission/*
!/plugins/Permission/ZhlCertificate
!/plugins/Permission/ZhlCertificate/*

# ZHL: track our custom pre-reservation plugin (Übergabe-Gate)
!/plugins/PreReservation
/plugins/PreReservation/*
!/plugins/PreReservation/ZhlHandover
!/plugins/PreReservation/ZhlHandover/*

# ZHL: track our custom post-reservation plugin (Übergabe-Verknüpfung)
!/plugins/PostReservation
/plugins/PostReservation/*
!/plugins/PostReservation/ZhlHandoverLink
!/plugins/PostReservation/ZhlHandoverLink/*
/config/zhl-cron.php
/config/zhl-handover.php

# ZHL: Zugangsdaten-Scratchpad (statt .env, das LB als Dotenv lädt)
/.zhl-credentials
docs/zhl/backups/
